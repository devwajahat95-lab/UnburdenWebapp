{
  "rewrites": [
    { "source": "/api/products/:id", "destination": "/api/products?id=:id" },
    { "source": "/api/podcast/episodes/:slug", "destination": "/api/podcast-episodes?slug=:slug" },
    { "source": "/api/podcast/episodes", "destination": "/api/podcast-episodes" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|.*\\.).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.js": { "maxDuration": 30 }
  }
}
