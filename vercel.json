{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.js": { "maxDuration": 30 },
    "api/webhooks/stripe.js": { "maxDuration": 60 },
    "api/email/campaigns/**/*.js": { "maxDuration": 60 }
  }
}
